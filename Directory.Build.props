<Project>
  <PropertyGroup>
    <!-- Beetle talks to Windows' BLE stack and grabs the screen, so it is a Windows-only build. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.1</Version>
    <Company>Fezcode</Company>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Beetle.Desktop'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
